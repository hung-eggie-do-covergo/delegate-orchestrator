#!/usr/bin/env bash
# orchestrate — launch a constrained multi-repo orchestrator for a ticket.
#
# Spins up a herdr workspace at the workspace root, starts a Claude agent with
# file-editing tools DISABLED (so it can only discover + delegate, never touch a
# repo itself — a capability boundary that survives context drift), and kicks off
# the delegate-orchestrator skill for the ticket. All repo work is done by the
# per-repo sub-agents `delegate` spawns, never by this orchestrator.
set -euo pipefail

HERDR="${HERDR_BIN:-herdr}"
# tools the orchestrator must never have — it delegates all file changes
DISALLOWED=(Edit Write NotebookEdit)

# Submit a prompt and confirm it went in. herdr's --wait returns
# agent_prompt_stalled if the agent never leaves idle — the Enter keystroke can be
# eaten by the target's UI redraw, leaving the text unsent. Then send-keys enter
# (NOT re-prompt, which doubles the text) and re-verify.
submit_prompt() {
  local pane=$1 text=$2 out
  if out=$("$HERDR" agent prompt "$pane" "$text" --wait --until working --timeout 5000 2>&1); then
    return 0
  elif printf '%s' "$out" | grep -qE 'agent_prompt_stalled|timeout'; then
    echo "prompt stalled on $pane — pressing Enter to submit" >&2
    "$HERDR" agent send-keys "$pane" enter >/dev/null 2>&1 || true
    "$HERDR" agent wait "$pane" --until working --timeout 5000 >/dev/null 2>&1 \
      || { echo "prompt on $pane never started the orchestrator after retry" >&2; return 1; }
  else
    echo "agent prompt failed: $out" >&2; return 1
  fi
}

usage() {
  cat <<'EOF'
Usage: orchestrate <ticket> [options]

  <ticket>        Ticket id to orchestrate (e.g. PROJ-1234)

Options:
  --cwd <path>          Workspace root the orchestrator scans (default: $PWD)
  --group <label>       Shared workspace that holds all orchestrators as tabs
                        (default: "orchestrators"). Reused across runs so the
                        sidebar shows one collapsible entry, not a flat pile.
  --label <text>        Tab label for this orchestrator (default: <ticket>)
  --task <text>         Extra task detail appended to the standard prompt
  --model <name>        Orchestrator's model (default: sonnet — it only
                        coordinates, never edits, so a cheap model fits).
  --delegate-model <n>  Default model the orchestrator hands each delegate
                        (default: opus — sub-agents do the real code work).
  --focus               Focus the new workspace (default: leave focus be)
  --dry-run             Print the herdr calls instead of running them
  -h, --help

Env: HERDR_BIN (default herdr)
EOF
}

[[ $# -lt 1 || "${1:-}" == "-h" || "${1:-}" == "--help" ]] && { usage; exit 0; }

ticket=$1; shift
cwd="$PWD" label="" task="" focus="--no-focus" dry=0 model="sonnet" delegate_model="opus" group="orchestrators"
while [[ $# -gt 0 ]]; do
  case $1 in
    --cwd) cwd=$2; shift 2;;
    --group) group=$2; shift 2;;
    --label) label=$2; shift 2;;
    --task) task=$2; shift 2;;
    --model) model=$2; shift 2;;
    --delegate-model) delegate_model=$2; shift 2;;
    --focus) focus="--focus"; shift;;
    --dry-run) dry=1; shift;;
    *) echo "unknown option: $1" >&2; exit 2;;
  esac
done

[[ -d "$cwd" ]] || { echo "not a directory: $cwd" >&2; exit 1; }
cwd=$(cd "$cwd" && pwd)
[[ -n "$label" ]] || label="$ticket"

# herdr agent names: lowercase [a-z0-9_-], start with a letter, <=32 chars.
name=$(printf 'orchestrator-%s' "$ticket" \
  | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' | sed 's/-\{2,\}/-/g; s/^-//; s/-$//')
name=${name:0:32}

read -r -d '' prompt <<EOF || true
Invoke the delegate-orchestrator skill for ticket $ticket. Your cwd ($cwd) is the workspace root to scan.

You are the ORCHESTRATOR. Your file-editing tools are disabled on purpose: you never edit repos, run builds/tests/migrations, or commit. You only discover (read-only scan), ask me which worktrees to reopen, call the \`delegate\` CLI to hand each repo's work to its own sub-agent, and report what delegate outputs. Every change to every repo is done by that repo's delegated sub-agent.

Model policy: delegate each repo with \`--model $delegate_model\` by default. Downgrade a repo to a cheaper model (e.g. sonnet, haiku) when its task is small or mechanical; upgrade only if the work is genuinely hard. State the model you chose per repo when you report.${task:+

$task}
EOF

if (( dry )); then
  echo "[dry-run] find-or-create workspace labelled '$group'; add a tab labelled '$label' (its root tab on first run) $focus"
  echo "[dry-run] $HERDR agent start $name --kind claude --pane <tab-pane> --timeout 120000 -- --model $model --disallowedTools ${DISALLOWED[*]}"
  echo "[dry-run] orchestrator model=$model  delegate default model=$delegate_model"
  echo "[dry-run] $HERDR agent prompt <tab-pane> <orchestrator-prompt>"
  exit 0
fi

# All orchestrators live as TABS in one shared workspace so the sidebar shows a
# single collapsible entry, not a flat workspace per ticket (herdr only auto-nests
# git worktrees; standalone workspaces can't be grouped). Find that workspace, or
# create it once and reuse its root tab for this first orchestrator.
ws=$("$HERDR" workspace list 2>/dev/null \
  | jq -r --arg l "$group" '.result.workspaces[]? | select((.label//"")==$l) | .workspace_id' | head -1)
if [[ -z "$ws" ]]; then
  create_json=$("$HERDR" workspace create --cwd "$cwd" --label "$group" $focus)
  ws=$(printf '%s' "$create_json" | jq -er '.result.workspace.workspace_id')
else
  create_json=$("$HERDR" tab create --workspace "$ws" --cwd "$cwd" --label "$label" $focus)
fi
pane=$(printf '%s' "$create_json" | jq -er '.result.root_pane.pane_id' | head -1)
tab=$(printf '%s' "$create_json" | jq -r '.result.tab.tab_id // .result.root_pane.tab_id // empty' | head -1)
[[ -n "$pane" ]] || { echo "could not read pane id:" >&2; echo "$create_json" >&2; exit 1; }
# label the tab with the ticket (the fresh workspace's root tab carries the group name)
[[ -n "$tab" ]] && "$HERDR" tab rename "$tab" "$label" >/dev/null 2>&1 || true
echo "orchestrator group='$group' workspace=$ws  tab=$tab  pane=$pane  model=$model  (edit tools disabled: ${DISALLOWED[*]}; delegate default model=$delegate_model)"

# A freshly created pane's shell boots a beat later; agent start returns
# agent_pane_busy until it's up. Wait briefly and retry.
started=0
for _ in $(seq 1 10); do
  if out=$("$HERDR" agent start "$name" --kind claude --pane "$pane" --timeout 120000 \
             -- --model "$model" --disallowedTools "${DISALLOWED[@]}" 2>&1); then started=1; break; fi
  printf '%s' "$out" | grep -q agent_pane_busy || { echo "agent start failed: $out" >&2; exit 1; }
  sleep 1
done
(( started )) || { echo "agent start: pane $pane never became an available shell" >&2; exit 1; }
submit_prompt "$pane" "$prompt" || exit 1
echo "launched orchestrator $name for $ticket in pane $pane"
echo "watch/answer: herdr tab focus ${tab:-$pane}   (or: herdr workspace focus $ws)"
